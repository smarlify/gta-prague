# Copy to .env.local and fill in. .env.local is git-ignored and never shipped.
# Used only by local scripts (npm run area:review). Do NOT prefix with VITE_:
# Vite would then bundle it into the public game.
TYPESAFE_API_KEY=

# Optional, for street furniture and reference photos (npm run city:furniture, photos:fetch, facades:photos):
# free token from https://www.mapillary.com/dashboard/developers
MAPILLARY_TOKEN=

# High-score / leaderboard client config (same Smarlify web app as Playful).
# Set for `npm run build` and on Heroku. Copy from Playful src/lib/firebase.ts
# or Crossy/Traffic env — never commit real secret material.
VITE_SCOREBOARD_WEB_KEY=
VITE_SCOREBOARD_AUTH_HOST=smarlify-api.firebaseapp.com
VITE_SCOREBOARD_PROJECT=smarlify-api
VITE_SCOREBOARD_BUCKET=smarlify-api.firebasestorage.app
VITE_SCOREBOARD_SENDER=117162085061
VITE_SCOREBOARD_APP=
VITE_SCOREBOARD_MEASUREMENT=

# Realtime Database (EU) on the same smarlify-api project — presence multiplayer.
# Create the DB in Firebase console if missing, publish database.rules.json, then set:
# VITE_SCOREBOARD_DATABASE_URL=https://smarlify-api-default-rtdb.europe-west1.firebasedatabase.app
VITE_SCOREBOARD_DATABASE_URL=
# Alias accepted by the client (same URL):
# VITE_MULTIPLAYER_DATABASE_URL=
