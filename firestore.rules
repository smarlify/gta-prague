rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function moneyUnchanged() {
      return request.resource.data.credits == resource.data.credits
        && request.resource.data.spent == resource.data.spent
        && request.resource.data.feePaid == resource.data.feePaid
        && request.resource.data.paused == resource.data.paused
        && request.resource.data.lastSettledDay == resource.data.lastSettledDay;
    }
    function boardChoiceOk() {
      return !('selectedBoardId' in request.resource.data)
        || (request.resource.data.selectedBoardId is string
          && request.resource.data.selectedBoardId.size() < 80
          && (request.resource.data.selectedBoardId == ''
            || request.resource.data.selectedBoardId.matches('^[a-z0-9]+(-[a-z0-9]+)*$')));
    }
    function linkUrlOk() {
      return !('linkUrl' in request.resource.data)
        || (request.resource.data.linkUrl is string
          && request.resource.data.linkUrl.size() < 2000
          && (request.resource.data.linkUrl == ''
            || request.resource.data.linkUrl.matches('https://[A-Za-z0-9.-]+(?::[0-9]+)?(?:[/?#][^\\s]*)?')
            || request.resource.data.linkUrl.matches('http://[A-Za-z0-9.-]+(?::[0-9]+)?(?:[/?#][^\\s]*)?')));
    }
    function linkUnset() {
      return !('linkUrl' in request.resource.data) || request.resource.data.linkUrl == '';
    }
    function accountKeys() {
      return request.resource.data.keys().hasOnly([
        'credits', 'spent', 'feePaid', 'imageUrl', 'linkUrl', 'paused', 'lastSettledDay', 'selectedBoardId'
      ]);
    }
    // matches() compares the whole string. A host-only pattern rejects the download URL.
    function ownBillboardImage(uid) {
      return request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() < 2000
        && (request.resource.data.imageUrl == ''
          || request.resource.data.imageUrl.matches('https://firebasestorage\\.googleapis\\.com/v0/b/[^/]+/o/billboards%2F' + uid + '%2F[^?]+(\\?.*)?'));
    }
    match /billboardAccounts/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && accountKeys()
        && request.resource.data.credits == 0
        && request.resource.data.spent == 0
        && request.resource.data.feePaid == false
        && request.resource.data.paused == true
        && request.resource.data.lastSettledDay == ''
        && request.resource.data.imageUrl == ''
        && request.resource.data.selectedBoardId == ''
        && linkUnset();
      allow update: if request.auth != null && request.auth.uid == uid
        && moneyUnchanged()
        && boardChoiceOk()
        && linkUrlOk()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['imageUrl', 'selectedBoardId', 'linkUrl'])
        && ownBillboardImage(uid);
      allow delete: if false;
    }
    match /billboardPayments/{id} {
      allow read, write: if false;
    }

    // Playful high scores in smarlify-api. The board's oldest score is 2025-11-12.
    // The hub shows name and score publicly. Clients may add a row, not change or delete one.
    function isHighScoreGame(gameId) {
      return gameId == 'crossy-road'
        || gameId == 'traffic-run'
        || gameId == 'gta-praha'
        || gameId == 'marooned';
    }
    function isHighScoreCreate() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 80
        && request.resource.data.score is number
        && request.resource.data.score > 0
        && request.resource.data.score <= 1000000000
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly(['name', 'score', 'createdAt', 'gameName', 'email', 'uid', 'level', 'id'])
        && (!('gameName' in request.resource.data) || (request.resource.data.gameName is string && request.resource.data.gameName.size() < 80))
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() < 200))
        && (!('uid' in request.resource.data) || (request.resource.data.uid is string && request.resource.data.uid.size() < 128))
        && (!('id' in request.resource.data) || (request.resource.data.id is string && request.resource.data.id.size() < 128))
        && (!('level' in request.resource.data) || request.resource.data.level is number);
    }
    match /leaderboards/{gameId}/scores/{scoreId} {
      allow read: if isHighScoreGame(gameId);
      allow create: if isHighScoreGame(gameId) && request.auth != null && isHighScoreCreate();
      allow update, delete: if false;
    }
  }
}
